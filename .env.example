# Copy to .env.local and fill in. Never commit .env.local.
# Server-only values have no NEXT_PUBLIC_ prefix. Only NEXT_PUBLIC_ values reach the browser.
#
# [used]    read by the code today
# [planned] reserved for a PRD feature that is not built yet; leave empty for now

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

# [used] Public URL of the app. Sent to OpenRouter as HTTP-Referer.
# [planned] Also the base for OAuth redirect URLs: <APP_URL>/api/connect/<platform>/callback
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Agents: Grow, Scout, Content, Pitch (PRD features 5-7)
# ---------------------------------------------------------------------------

# [used] Get a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# [used] Any OpenRouter model that supports structured outputs (json_schema).
# Cheaper for testing: anthropic/claude-haiku-5.5
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# [used] An agent call that takes longer than this stops, and the app shows Try again.
OPENROUTER_TIMEOUT_MS=45000

# ---------------------------------------------------------------------------
# Supabase: sign up and log in, database, talent pictures (PRD features 1-8)
# Find these in the Supabase dashboard > Project Settings > API Keys / Data API.
# ---------------------------------------------------------------------------

# [planned] Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# [planned] Publishable key (sb_publishable_...). Safe in the browser: row-level security
# limits each student to their own agency, talents, ideas and pitches.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# [planned] Secret key (sb_secret_...). Server only. It skips row-level security, so never
# send it to the browser or import it from a client component.
SUPABASE_SECRET_KEY=

# [planned] Storage bucket for talent pictures (and videos later).
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=ai-influencer-agency

# [planned] Direct Postgres connection string, for running migrations only.
# Dashboard > Connect > Session pooler. The app itself talks to Supabase through the keys above.
# TLS: verify with the Supabase root CA in certs/supabase-ca.crt (Project Settings > Database > SSL).
DATABASE_URL=

# [planned] Key for encrypting TikTok, Meta and Google access tokens before they go into the
# database. Make one with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Social platforms: connect accounts and read numbers (PRD features 3-4)
# Accounts that will not connect can still be added by handle, so every platform is optional.
# ---------------------------------------------------------------------------

# [planned] TikTok for Developers app (Login Kit + Display API). https://developers.tiktok.com/apps
# Scopes: user.info.basic, user.info.stats, video.list
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# [planned] Meta app for Instagram and Facebook Pages. https://developers.facebook.com/apps
# Instagram needs a Business or Creator account and Meta app review for public use.
# Scopes: instagram_business_basic, instagram_business_manage_insights, pages_show_list, pages_read_engagement, read_insights
META_APP_ID=
META_APP_SECRET=

# [used] Google Cloud API key with YouTube Data API v3 on. https://console.cloud.google.com/apis/credentials
# Restrict the key to YouTube Data API v3. Channels are found by handle and only public numbers are
# read, so there is no sign-in and no Google review. YouTube watch time shows "Not available".
YOUTUBE_API_KEY=
