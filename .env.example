# Copy to .env.local and fill in. Never commit .env.local.

# OpenRouter key for the Grow, Scout, Content and Pitch agents.
# Get one at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Any OpenRouter model that supports structured outputs (json_schema).
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# An agent call that takes longer than this stops, and the app shows Try again.
OPENROUTER_TIMEOUT_MS=45000

# Sent to OpenRouter as HTTP-Referer, so usage shows under this app.
APP_URL=http://localhost:3000
